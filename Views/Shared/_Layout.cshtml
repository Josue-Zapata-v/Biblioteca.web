<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Libros" asp-action="Index">
                    <i class="bi bi-journal-bookmark text-primary fs-5 me-2"></i>
                    <span>Biblioteca<span class="text-primary">.Web</span></span>
                </a>
                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Navegación">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Libros" asp-action="Index">
                                <i class="bi bi-book me-1.5"></i>Libros
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Socios" asp-action="Index">
                                <i class="bi bi-people me-1.5"></i>Socios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Prestamos" asp-action="Reporte">
                                <i class="bi bi-graph-up-arrow me-1.5"></i>Reporte de Préstamos
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-muted small">
                        <span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1.5">
                            <i class="bi bi-database me-1"></i>BibliotecaDB
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year Biblioteca.Web &bull; Gestión Bibliotecaria</span>
            <span class="text-secondary small">MVC con Dapper &bull; Semana 08</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
