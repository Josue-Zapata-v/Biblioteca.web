@model IEnumerable<Biblioteca.Web.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
    var buscarTitulo = ViewData["BuscarTitulo"] as string;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1 text-dark">Catálogo de Libros</h1>
        <p class="text-muted small mb-0">Inventario y administración de ejemplares disponibles en la biblioteca</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i>
            <span>Nuevo Libro</span>
        </a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    var tipoMensaje = TempData["TipoMensaje"] ?? "info";
    var icono = tipoMensaje.ToString() == "success" ? "bi-check-circle-fill" :
                tipoMensaje.ToString() == "warning" ? "bi-exclamation-triangle-fill" :
                tipoMensaje.ToString() == "danger" ? "bi-x-circle-fill" : "bi-info-circle-fill";

    <div class="alert alert-@tipoMensaje alert-dismissible d-flex align-items-center fade show shadow-sm" role="alert">
        <i class="bi @icono fs-5 me-2"></i>
        <div>@TempData["Mensaje"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="buscarTitulo" value="@buscarTitulo" class="form-control border-start-0 ps-0" placeholder="Buscar libro por título..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">
                    Buscar
                </button>
                @if (!string.IsNullOrEmpty(buscarTitulo))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtro">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Título</th>
                    <th scope="col" style="width: 170px;">ISBN</th>
                    <th scope="col">Autor</th>
                    <th scope="col" style="width: 150px;">Disponibilidad</th>
                    <th scope="col" style="width: 250px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var libro in Model)
                    {
                        <partial name="_LibroFila" model="libro" />
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="bi bi-book"></i>
                                </div>
                                <h6 class="fw-semibold text-secondary mb-1">No se encontraron libros</h6>
                                <p class="text-muted small mb-3">
                                    @(string.IsNullOrEmpty(buscarTitulo) 
                                        ? "Aún no se han registrado libros activos en el sistema." 
                                        : $"No hay coincidencias con el término '{buscarTitulo}'.")
                                </p>
                                @if (!string.IsNullOrEmpty(buscarTitulo))
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-arrow-counterclockwise"></i> Ver todos los libros
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
